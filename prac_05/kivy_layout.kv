BoxLayout:
    orientation: "vertical"

    Label:
        text: app.status_text
        size_hint_y: 0.2

    BoxLayout:
        size_hint_y: 0.6
        Button:
            text: "+"
            on_press: app.handle_press(1)
        Button:
            text: "-"
            on_press: app.handle_press(-1)

    BoxLayout:
        id: names_box
        size_hint_y: 0.2

    Label:
        text: "I did this :)"
        size_hint_y: 0.1